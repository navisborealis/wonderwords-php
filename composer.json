{
  "name": "navisborealis/wonderwords-php",
  "description": "Generate random words, phrases, and grammatically correct sentences in PHP. Perfect for seeding databases with realistic test data.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "adjective",
    "noun",
    "word",
    "generator",
    "phrase",
    "sentence",
    "profanity",
    "profanity-filter",
    "fake-data",
    "testing",
    "seeder",
    "names",
    "colors",
    "animals",
    "tech-terms",
    "adverbs"
  ],
  "homepage": "https://github.com/navisborealis/wonderwords-php",
  "require": {
    "php": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "NavisBorealis\\WonderwordsPhp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NavisBorealis\\WonderwordsPhp\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Piotr Grabski-Gradziński",
      "email": "piotr.gradzinski@navisborealis.io"
    }
  ],
  "minimum-stability": "dev",
  "require-dev": {
    "php-coveralls/php-coveralls": "dev-master",
    "phpunit/phpunit": "^7.5 || ^8.5 || ^9.6",
    "phpstan/phpstan": "^1.4",
    "friendsofphp/php-cs-fixer": "^3.1",
    "fakerphp/faker": "2.0.x-dev"
  }
}
